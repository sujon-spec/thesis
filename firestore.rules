rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Thesis tracker: each group is stored in a separate document.
    // The app only subscribes to the logged-in student group's document.
    match /thesistrack/{groupId} {
      allow read, write: if groupId.matches('group-0[1-7]');
    }
  }
}
